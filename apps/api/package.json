    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@seen/core": "workspace:*",
    "@seen/providers": "workspace:*",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.6",
    "@nestjs/testing": "^11.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
