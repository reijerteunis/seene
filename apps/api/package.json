{
  "name": "@seen/api",
  "version": "0.0.0",
  "private": true,
  "description": "The HTTP surface: connections, findings, claims and the approval inbox.",
  "main": "./dist/apps/api/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "node dist/apps/api/src/main.js",
