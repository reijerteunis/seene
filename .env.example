# Copy to .env.local and fill in. .env.local is gitignored and is the secrets
# provider's store until the go decision in SEEN-007 moves them to Secret Manager.
#
# Every value here is a local default or a placeholder. Nothing in this file is a
# credential, and nothing that is a credential belongs in it.

# Which implementation each provider uses. These three are the whole of the cloud
# switch: nothing else in the codebase decides where secrets, bytes or traces go.
# Local: env, supabase, console. After SEEN-007: gcp-secret-manager, gcs, cloud-logging.
SEEN_SECRETS_PROVIDER=env
SEEN_STORAGE_PROVIDER=supabase
SEEN_TELEMETRY_PROVIDER=otlp

# Supabase, from `supabase status -o env` after `pnpm dev:up`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEEN_STORAGE_BUCKET=evidence

# Postgres, for migrations and psql.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis, for BullMQ. The same two variables CI sets.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mailpit: SMTP to send, HTTP to read what was sent.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SEEN_MAIL_FROM="Seen <seen@localhost>"
MAILPIT_URL=http://127.0.0.1:8025

# The collector from docker-compose.yml.
SEEN_OTLP_ENDPOINT=http://127.0.0.1:4318
SEEN_SERVICE_NAME=seen-api

# apps/api. Cloud Run sets PORT; 8080 is its default and ours.
PORT=8080

# Marketplace credentials, read through the secrets provider as
# SEEN_SECRET_<reference shouted>. One per connection, added as each connector lands.
# SEEN_SECRET_BOL_NL_CLIENT_ID=
# SEEN_SECRET_BOL_NL_CLIENT_SECRET=
