{
  "name": "seen",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:up": "./scripts/dev-up.sh",
    "dev:down": "./scripts/dev-down.sh",
    "db:reset": "supabase db reset",
    "replay:inbound": "./scripts/replay-inbound.sh",
    "tunnel": "./scripts/tunnel.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "rules": "./scripts/rules.sh tree",
    "rules:staged": "./scripts/rules.sh staged",
    "rules:fixtures": "./scripts/rules.sh fixtures"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "18.5.0",
    "knip": "6.39.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18"
    },
    "onlyBuiltDependencies": [
      "@ast-grep/cli",
      "@biomejs/biome"
    ]
  }
}
