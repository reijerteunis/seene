# Working copies of stage templates. Only the journal is evidence.
.harness-drafts/
# The harness's advisory lock, never committed.
.harness.lock

# Python
__pycache__/
*.py[cod]

# Node, from SEEN-006 onwards
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo

# Secrets and local settings
.env
.env.local
.DS_Store

# graphify: the graph and its report are committed, the machine-local state is not
graphify-out/cache/
graphify-out/manifest.json
graphify-out/graph.html
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
# Dated snapshots graphify writes beside the graph: regenerable, and they
# double the churn on every commit.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Monorepo build and tool output (SEEN-006)
.turbo/
*.tsbuildinfo
coverage/

# repowise's local index and wiki, from SEEN-098. Rebuilt from the tree by
# repowise update, so it is derived rather than evidence, and 64 per cent of
# what it would index is the journal.
.repowise/
# Editor and agent wiring repowise writes. Each machine points at its own
# absolute paths, so committing it would hand the next machine a broken one.
.vscode/mcp.json
.vscode/extensions.json
.codex/*
# Except the agent copies sync generates, from SEEN-105, and the hook copy it
# generates from SEEN-106: they carry no machine-local path, their commands are
# relative to the repository, and committing them means a fresh clone has the
# agents and the hooks before its first sync, the way the skill copies do.
# .codex/config.toml stays out for the reason above.
!.codex/agents/
!.codex/hooks.json
# repowise's managed Codex entry point, from SEEN-102. It is CLAUDE.md with
# Codex substituted for Claude Code throughout, which breaks a filename inside
# a link and rewrites the branch rule to a prefix the harness refuses. Codex
# reads .agents/skills/seen-harness/SKILL.md, which sync generates.
AGENTS.md

# The local Docker environment, from SEEN-097. Studio's scratch directory is created
# by dev:up because docker cannot chown a mount source it creates on some mounts;
# nothing in it is ours to keep. supabase/.gitignore covers the CLI's own state.
supabase/snippets/
