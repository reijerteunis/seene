# The harness's advisory lock, never committed.
.harness.lock

# Python
__pycache__/
*.py[cod]

# Node, from SEEN-006 onwards
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo

# Secrets and local settings
.env
.env.local
.DS_Store

# graphify: the graph and its report are committed, the machine-local state is not
graphify-out/cache/
graphify-out/manifest.json
graphify-out/graph.html
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
