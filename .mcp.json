{
  "mcpServers": {
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [
        "--graph",
        "graphify-out/graph.json"
      ],
      "env": {}
    },
    "repowise": {
      "type": "stdio",
      "command": "repowise",
      "args": [
        "mcp",
        "--transport",
        "stdio"
      ],
      "env": {}
    }
  }
}
